# Architecture for AWS Emulator RPM:
# Use 'aarch64' for Apple Silicon (M1/M2/M3/M4) or ARM-based Linux
# Use 'x86_64' for Intel/AMD processors
EMULATOR_ARCH=aarch64

# Host port for Python backend API (avoid conflicting with 8000/8001)
PYTHON_PORT=8002

# SMTP (optional) - 実メール送信の初期値。Web UI の Mailbox / Pipeline 画面からも設定できます。
# 画面で保存した設定はコンテナ内に保存され、そちらが優先されます（コンテナ削除で消えます）。
# 毎回同じ SMTP を使う場合はここに書いてください。
# SMTP_HOST が空なら実送信は無効（メールは Mailbox にのみ記録）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aws-emulator@local.test
